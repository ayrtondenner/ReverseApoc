#!/bin/sh
# commit-msg: give commits made under Claude Code a Co-Authored-By trailer.
#
# Claude Code sets CLAUDECODE=1 for every command it runs, including the commits and merges
# that GSD tooling makes on its own (`gsd-tools query commit`, `git merge --no-ff --no-edit -m`).
# When CLAUDECODE is set and the message has no Co-Authored-By trailer yet (any case), this
# appends one. The value defaults to "Claude <noreply@anthropic.com>"; override it per clone
# with `git config reverseapoc.coauthor "Name <email>"`. Without CLAUDECODE the message is left
# alone. The hook is idempotent and always exits 0, so it never blocks a commit.
#
# Enable once per clone: git config core.hooksPath .githooks

msg_file=$1

[ -n "${CLAUDECODE:-}" ] || exit 0
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# An empty message (blank, or comment lines only) must stay empty so git still aborts the commit.
[ -n "$(git stripspace --strip-comments < "$msg_file" 2>/dev/null)" ] || exit 0

if git interpret-trailers --parse "$msg_file" 2>/dev/null | grep -qi '^co-authored-by:'; then
    exit 0
fi

# git 2.43 passes a `merge -m` message without a final newline, and interpret-trailers would then
# glue the trailer onto the subject line; end the message with a newline first.
[ -z "$(tail -c 1 "$msg_file")" ] || printf '\n' >> "$msg_file"

coauthor=$(git config --get reverseapoc.coauthor 2>/dev/null)
[ -n "$coauthor" ] || coauthor='Claude <noreply@anthropic.com>'

git interpret-trailers --in-place --trailer "Co-Authored-By: $coauthor" "$msg_file" \
    >/dev/null 2>&1 || true
exit 0
